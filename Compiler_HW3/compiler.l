/* Definition section */
%{
    #include "compiler_common.h"
    #include "y.tab.h"	/* header file generated by bison */
    extern YYSTYPE yylval;

    #define YY_NO_UNPUT
    #define YY_NO_INPUT
    #define XXX printf("not implemented yet!\n")
%}

/* Define regular expression label */
letter [a-zA-Z_]
ident {letter}+({letter}|{digit})*
digit [0-9]
inumber {digit}+
fnumber ({digit}*\.{digit}+)

%x CMT
%option yylineno

/* Rules section */
%%

"/*"        { BEGIN(CMT); }
<CMT>\r?\n   { ; }
<CMT>.     { ; }
<CMT>"*/"      { BEGIN(INITIAL); }
"//".*      {;}
\"(\\.|[^\"\\])*\"   { 
    char *str = strdup(yytext + 1);
    str[strlen(str) - 1] = '\0';
    yylval.s_val = str;
    return STRING_LIT;
}

\r?\n       {;}
"str"       { return STR; }
"<<"        { return LSHIFT; }
"+"         { return '+'; }
"-"         { return '-'; }
"*"         { return '*'; }
"/"         { return '/'; }
"%"         { return '%'; }
">"         { return '>'; }
"<"         { return '<'; }
">="        { return GEQ; }
"<="        { return LEQ; }
"=="        { return EQL; }
"!="        { return NEQ; }
"="         { return '='; }
"+="        { return ADD_ASSIGN; }
"-="        { return SUB_ASSIGN; }
"*="        { return MUL_ASSIGN; }
"/="        { return DIV_ASSIGN; }
"%="        { return REM_ASSIGN; }
"&&"        { return LAND; }
"||"        { return LOR; }
"!"         { return '!'; }
"&"         { return '&'; }
"|"         { return '|'; }
'~'         { return '~'; }
"("         { return '('; }
")"         { return ')'; }
"["         { return '['; }
"]"         { return ']'; }
"{"         { return '{'; }
"}"         { return '}'; }
":"         { return ':'; }
";"         { return ';'; }
","         { return ','; }

"print"     { return PRINT; }
"println"   { return PRINTLN; }

"if"        { return IF; }
"else"      { return ELSE; }
"while"     { return WHILE; }
"i32"       { return INT; }
"f32"       { return FLOAT;}
"bool"      { return BOOL; }
"true"      { return TRUE; }
"false"     { return FALSE; }
"as"        { return AS; }
"fn"        { return FUNC; }
"let"       { return LET; }
"mut"       { return MUT; }

{inumber}   { yylval.i_val = atoi(yytext);
                return INT_LIT;
            }
{fnumber}   { yylval.f_val = atof(yytext);
                return FLOAT_LIT;
            }
{ident}        { yylval.s_val = strdup(yytext); return IDENT;}
<<EOF>>     { 
                yyterminate();
            }
[ \t]+      {;}
%%
/*  C Code section */
int yywrap(void)
{
    return 1;
}
